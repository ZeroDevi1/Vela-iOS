diff --git a/Sources/KSPlayer/MEPlayer/CachedHTTPInput.swift b/Sources/KSPlayer/MEPlayer/CachedHTTPInput.swift
new file mode 100644
index 0000000..a249187
--- /dev/null
+++ b/Sources/KSPlayer/MEPlayer/CachedHTTPInput.swift
@@ -0,0 +1,175 @@
+import Darwin
+import FFmpegKit
+import Foundation
+import Libavformat
+import Libavutil
+
+/// Bounded byte cache below the demuxer. Seeks reset decoder queues but keep previously read pages.
+final class CachedHTTPInput {
+    private static let pageSize = 1_048_576
+
+    private struct Page {
+        let slot: Int
+        var validBytes: Range<Int>
+    }
+
+    // Updated on FFmpeg's read thread and sampled by the player UI.
+    final class NetworkCounter: @unchecked Sendable {
+        private let lock = NSLock()
+        private var bytes: Int64?
+
+        var value: Int64? {
+            get { lock.withLock { bytes } }
+            set { lock.withLock { bytes = newValue } }
+        }
+    }
+
+    private var upstream: UnsafeMutablePointer<AVIOContext>?
+    private let length: Int64
+    private let descriptor: Int32
+    private let networkCounter: NetworkCounter
+    private var upstreamOffset: Int64 = 0
+    private var position: Int64 = 0
+    private var pages: [Int64: Page] = [:]
+    private var slots: [Int64?]
+    private var nextSlot = 0
+    private(set) var context: UnsafeMutablePointer<AVIOContext>?
+
+    private init(
+        upstream: UnsafeMutablePointer<AVIOContext>, length: Int64, descriptor: Int32,
+        pageCount: Int, networkCounter: NetworkCounter
+    ) {
+        self.upstream = upstream
+        self.length = length
+        self.descriptor = descriptor
+        self.networkCounter = networkCounter
+        slots = Array(repeating: nil, count: pageCount)
+    }
+
+    static func open(
+        url: String, byteLimit: Int, interrupt: inout AVIOInterruptCB, options: inout OpaquePointer?,
+        networkCounter: NetworkCounter
+    ) -> CachedHTTPInput? {
+        let pageCount = byteLimit / pageSize
+        guard pageCount > 0 else { return nil }
+
+        // An unlinked temporary file releases its storage even if the app is terminated.
+        var path = Array(FileManager.default.temporaryDirectory.appendingPathComponent("vela-video.XXXXXX").path.utf8CString)
+        let descriptor = mkstemp(&path)
+        guard descriptor >= 0 else { return nil }
+        guard unlink(path) == 0 else {
+            Darwin.close(descriptor)
+            return nil
+        }
+
+        var upstream: UnsafeMutablePointer<AVIOContext>?
+        guard avio_open2(&upstream, url, AVIO_FLAG_READ, &interrupt, &options) >= 0,
+              let input = upstream, input.pointee.seekable > 0,
+              case let length = avio_size(input), length > 0 else {
+            avio_closep(&upstream)
+            Darwin.close(descriptor)
+            return nil
+        }
+
+        let cache = CachedHTTPInput(
+            upstream: input, length: length, descriptor: descriptor, pageCount: pageCount, networkCounter: networkCounter
+        )
+        let bufferSize: Int32 = 64 * 1024
+        guard let buffer = av_malloc(Int(bufferSize))?.assumingMemoryBound(to: UInt8.self) else { return nil }
+        cache.context = avio_alloc_context(buffer, bufferSize, 0, Unmanaged.passUnretained(cache).toOpaque(), { opaque, buffer, size in
+            guard let opaque, let buffer else { return -EINVAL }
+            let cache = Unmanaged<CachedHTTPInput>.fromOpaque(opaque).takeUnretainedValue()
+            return cache.read(into: buffer, size: size)
+        }, nil, { opaque, offset, whence in
+            guard let opaque else { return Int64(-EINVAL) }
+            let cache = Unmanaged<CachedHTTPInput>.fromOpaque(opaque).takeUnretainedValue()
+            return cache.seek(offset: offset, whence: whence)
+        })
+        guard cache.context != nil else {
+            av_free(buffer)
+            return nil
+        }
+        networkCounter.value = input.pointee.bytes_read
+        return cache
+    }
+
+    deinit {
+        if let context { av_free(context.pointee.buffer) }
+        avio_context_free(&context)
+        avio_closep(&upstream)
+        Darwin.close(descriptor)
+    }
+
+    private func seek(offset: Int64, whence: Int32) -> Int64 {
+        let origin: Int64
+        switch whence & ~AVSEEK_FORCE {
+        case AVSEEK_SIZE: return length
+        case SEEK_SET: origin = 0
+        case SEEK_CUR: origin = position
+        case SEEK_END: origin = length
+        default: return Int64(-EINVAL)
+        }
+        let (target, overflow) = origin.addingReportingOverflow(offset)
+        guard !overflow, target >= 0 else { return Int64(-EINVAL) }
+        // Only move the HTTP input on a cache miss.
+        position = target
+        return target
+    }
+
+    private func read(into buffer: UnsafeMutablePointer<UInt8>, size: Int32) -> Int32 {
+        guard position < length else { return AVError.eof.code }
+        let pageNumber = position / Int64(Self.pageSize)
+        let pageOffset = Int(position % Int64(Self.pageSize))
+        let page = pages[pageNumber]
+        var count = min(Int(size), Self.pageSize - pageOffset)
+        if let page, page.validBytes.contains(pageOffset) {
+            let diskOffset = off_t(page.slot * Self.pageSize + pageOffset)
+            let read = pread(descriptor, buffer, min(count, page.validBytes.upperBound - pageOffset), diskOffset)
+            if read > 0 {
+                position += Int64(read)
+                return Int32(read)
+            }
+        } else if let page, pageOffset < page.validBytes.lowerBound {
+            count = min(count, page.validBytes.lowerBound - pageOffset)
+        }
+
+        if upstreamOffset != position {
+            let offset = avio_seek(upstream, position, SEEK_SET)
+            guard offset == position else { return offset < 0 ? Int32(clamping: offset) : -EIO }
+            upstreamOffset = offset
+        }
+        let read = avio_read_partial(upstream, buffer, Int32(count))
+        networkCounter.value = upstream?.pointee.bytes_read
+        guard read > 0 else { return read == 0 ? AVError.eof.code : read }
+        position += Int64(read)
+        upstreamOffset += Int64(read)
+        store(buffer, pageNumber: pageNumber, range: pageOffset..<(pageOffset + Int(read)))
+        return read
+    }
+
+    private func store(_ buffer: UnsafePointer<UInt8>, pageNumber: Int64, range: Range<Int>) {
+        var page: Page
+        if let existing = pages[pageNumber] {
+            page = existing
+        } else {
+            if let evicted = slots[nextSlot] { pages[evicted] = nil }
+            slots[nextSlot] = pageNumber
+            page = Page(slot: nextSlot, validBytes: range)
+            nextSlot = (nextSlot + 1) % slots.count
+        }
+
+        let diskOffset = off_t(page.slot * Self.pageSize + range.lowerBound)
+        guard pwrite(descriptor, buffer, range.count, diskOffset) == range.count else {
+            // Playback can continue from the network if the temporary directory fills up.
+            pages[pageNumber] = nil
+            slots[page.slot] = nil
+            return
+        }
+        if range.lowerBound <= page.validBytes.upperBound, range.upperBound >= page.validBytes.lowerBound {
+            page.validBytes = min(range.lowerBound, page.validBytes.lowerBound)..<max(range.upperBound, page.validBytes.upperBound)
+        } else {
+            page.validBytes = range
+        }
+        pages[pageNumber] = page
+    }
+}
