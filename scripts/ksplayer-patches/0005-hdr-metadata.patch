diff --git a/Sources/KSPlayer/MEPlayer/HDRMetadata.swift b/Sources/KSPlayer/MEPlayer/HDRMetadata.swift
new file mode 100644
index 0000000..fcbfe05
--- /dev/null
+++ b/Sources/KSPlayer/MEPlayer/HDRMetadata.swift
@@ -0,0 +1,261 @@
+//
+//  HDRMetadata.swift
+//  KSPlayer
+//
+//  Vela: HDR10 static metadata (SMPTE ST 2086 mastering display / CTA-861.3 content light level) and HDR10+
+//  dynamic metadata (SMPTE ST 2094-40) handed to the system compositor, so tone mapping on displays dimmer than
+//  the mastering display uses the content's real range instead of a 1000-nit default.
+//
+
+import CoreMedia
+import CoreVideo
+import Libavcodec
+import Libavutil
+
+extension MasteringDisplayMetadata {
+    /// From FFmpeg's rationals (primaries R, G, B order); nil unless both primaries and luminance are present.
+    /// Units as in the HEVC SEI: chromaticity in 0.00002, luminance in 0.0001 cd/m².
+    init?(_ metadata: AVMasteringDisplayMetadata) {
+        guard metadata.has_primaries != 0, metadata.has_luminance != 0 else { return nil }
+        func scaled(_ value: AVRational, _ scale: Double) -> Double {
+            value.den == 0 ? 0 : Double(value.num) / Double(value.den) * scale
+        }
+        func chroma(_ value: AVRational) -> UInt16 { UInt16(clamping: Int(scaled(value, 50000).rounded())) }
+        func luminance(_ value: AVRational) -> UInt32 { UInt32(clamping: Int64(scaled(value, 10000).rounded())) }
+        let primaries = metadata.display_primaries
+        self.init(
+            display_primaries_r_x: chroma(primaries.0.0), display_primaries_r_y: chroma(primaries.0.1),
+            display_primaries_g_x: chroma(primaries.1.0), display_primaries_g_y: chroma(primaries.1.1),
+            display_primaries_b_x: chroma(primaries.2.0), display_primaries_b_y: chroma(primaries.2.1),
+            white_point_x: chroma(metadata.white_point.0), white_point_y: chroma(metadata.white_point.1),
+            minLuminance: luminance(metadata.min_luminance), maxLuminance: luminance(metadata.max_luminance)
+        )
+    }
+
+    /// 24-byte big-endian payload of the HEVC mastering display colour volume SEI (D.2.28): primaries in G, B, R
+    /// order, white point, max then min luminance. Format of `kCVImageBufferMasteringDisplayColorVolumeKey` and
+    /// `CAEDRMetadata.hdr10(displayInfo:…)`.
+    var seiData: Data {
+        var data = Data(capacity: 24)
+        for value in [display_primaries_g_x, display_primaries_g_y, display_primaries_b_x, display_primaries_b_y,
+                      display_primaries_r_x, display_primaries_r_y, white_point_x, white_point_y]
+        {
+            withUnsafeBytes(of: value.bigEndian) { data.append(contentsOf: $0) }
+        }
+        withUnsafeBytes(of: maxLuminance.bigEndian) { data.append(contentsOf: $0) }
+        withUnsafeBytes(of: minLuminance.bigEndian) { data.append(contentsOf: $0) }
+        return data
+    }
+}
+
+extension MasteringDisplayMetadata {
+    /// From a mastering display colour volume SEI payload (H.264 D.2.29 / HEVC D.2.28, primaries G, B, R).
+    init?(seiPayload data: Data) {
+        guard data.count >= 24 else { return nil }
+        let bytes = [UInt8](data.prefix(24))
+        func u16(_ i: Int) -> UInt16 { UInt16(bytes[i]) << 8 | UInt16(bytes[i + 1]) }
+        func u32(_ i: Int) -> UInt32 { UInt32(u16(i)) << 16 | UInt32(u16(i + 2)) }
+        self.init(
+            display_primaries_r_x: u16(8), display_primaries_r_y: u16(10),
+            display_primaries_g_x: u16(0), display_primaries_g_y: u16(2),
+            display_primaries_b_x: u16(4), display_primaries_b_y: u16(6),
+            white_point_x: u16(12), white_point_y: u16(14),
+            minLuminance: u32(20), maxLuminance: u32(16)
+        )
+    }
+}
+
+extension ContentLightMetadata {
+    /// From a content light level information SEI payload.
+    init?(seiPayload data: Data) {
+        guard data.count >= 4 else { return nil }
+        let bytes = [UInt8](data.prefix(4))
+        self.init(MaxCLL: UInt16(bytes[0]) << 8 | UInt16(bytes[1]), MaxFALL: UInt16(bytes[2]) << 8 | UInt16(bytes[3]))
+    }
+
+    init(_ metadata: AVContentLightMetadata) {
+        self.init(MaxCLL: UInt16(clamping: metadata.MaxCLL), MaxFALL: UInt16(clamping: metadata.MaxFALL))
+    }
+
+    /// 4-byte big-endian payload of the content light level SEI (`kCVImageBufferContentLightLevelInfoKey`).
+    var seiData: Data {
+        var data = Data(capacity: 4)
+        withUnsafeBytes(of: MaxCLL.bigEndian) { data.append(contentsOf: $0) }
+        withUnsafeBytes(of: MaxFALL.bigEndian) { data.append(contentsOf: $0) }
+        return data
+    }
+}
+
+extension EDRMetaData {
+    /// Container-level metadata (`mdcv` / `clli` boxes, Matroska `MasteringMetadata`); nil if the track has none.
+    init?(codecpar: AVCodecParameters) {
+        var displayData: MasteringDisplayMetadata?
+        var contentData: ContentLightMetadata?
+        if codecpar.nb_coded_side_data > 0, let sideDatas = codecpar.coded_side_data {
+            for i in 0 ..< Int(codecpar.nb_coded_side_data) {
+                let sideData = sideDatas[i]
+                guard let data = sideData.data else { continue }
+                if sideData.type == AV_PKT_DATA_MASTERING_DISPLAY_METADATA,
+                   sideData.size >= MemoryLayout<AVMasteringDisplayMetadata>.size
+                {
+                    displayData = data.withMemoryRebound(to: AVMasteringDisplayMetadata.self, capacity: 1) {
+                        MasteringDisplayMetadata($0.pointee)
+                    }
+                } else if sideData.type == AV_PKT_DATA_CONTENT_LIGHT_LEVEL,
+                          sideData.size >= MemoryLayout<AVContentLightMetadata>.size
+                {
+                    contentData = data.withMemoryRebound(to: AVContentLightMetadata.self, capacity: 1) {
+                        ContentLightMetadata($0.pointee)
+                    }
+                }
+            }
+        }
+        guard displayData != nil || contentData != nil else { return nil }
+        self.init(displayData: displayData, contentData: contentData, ambientViewingEnvironment: nil)
+    }
+
+    /// Fields present in `newer` replace ours (a stream's SEI overrides the container; later SEI the earlier one).
+    func merging(_ newer: EDRMetaData) -> EDRMetaData {
+        EDRMetaData(displayData: newer.displayData ?? displayData, contentData: newer.contentData ?? contentData,
+                    ambientViewingEnvironment: newer.ambientViewingEnvironment ?? ambientViewingEnvironment)
+    }
+
+    /// Format description extensions, so a hardware decoder session and the display layer see the metadata
+    /// before the first frame.
+    var formatDescriptionExtensions: [CFString: Data] {
+        var extensions = [CFString: Data]()
+        extensions[kCMFormatDescriptionExtension_MasteringDisplayColorVolume] = displayData?.seiData
+        extensions[kCMFormatDescriptionExtension_ContentLightLevelInfo] = contentData?.seiData
+        return extensions
+    }
+
+    /// Attach to a decoded frame. Propagated attachments end up in the format description that
+    /// `AVSampleBufferDisplayLayer` receives (`CMVideoFormatDescriptionCreateForImageBuffer`).
+    func attach(to pixelBuffer: CVPixelBuffer) {
+        if let data = displayData?.seiData as CFData? {
+            CVBufferSetAttachment(pixelBuffer, kCVImageBufferMasteringDisplayColorVolumeKey, data, .shouldPropagate)
+        }
+        if let data = contentData?.seiData as CFData? {
+            CVBufferSetAttachment(pixelBuffer, kCVImageBufferContentLightLevelInfoKey, data, .shouldPropagate)
+        }
+    }
+}
+
+/// HDR10+ metadata of one frame as an ITU-T T.35 payload starting at the country code (0xB5), the format of
+/// `kCMSampleAttachmentKey_HDR10PlusPerFrameData`; nil if FFmpeg cannot serialize it.
+func hdr10PlusT35Data(_ metadata: UnsafePointer<AVDynamicHDRPlus>) -> Data? {
+    var buffer: UnsafeMutablePointer<UInt8>?
+    var size = 0
+    guard av_dynamic_hdr_plus_to_t35(metadata, &buffer, &size) == 0, let buffer else { return nil }
+    defer { av_free(buffer) }
+    // FFmpeg omits the 6-byte header (country code 0xB5, provider code 0x003C, provider oriented code 0x0001,
+    // application identifier 4) and starts at application_mode; the attachment needs it.
+    return Data([0xB5, 0x00, 0x3C, 0x00, 0x01, 0x04]) + Data(bytes: buffer, count: size)
+}
+
+/// HDR metadata SEI messages found in one compressed access unit, for the VideoToolbox path: unlike FFmpeg's
+/// decoders, `VTDecompressionSession` does not attach in-band mastering display / content light level SEI to its
+/// output (only the format description's extensions), and the HDR10+ payload is needed for the display layer.
+struct HDRSEIScanner {
+    private let nalLengthSize: Int
+    private let isHEVC: Bool
+
+    /// nil unless the track is length-prefixed (`avcC` / `hvcC`) H.264 or HEVC.
+    init?(assetTrack: FFmpegAssetTrack) {
+        let codecpar = assetTrack.codecpar
+        isHEVC = codecpar.codec_id == AV_CODEC_ID_HEVC
+        guard isHEVC || codecpar.codec_id == AV_CODEC_ID_H264, let extradata = codecpar.extradata else { return nil }
+        if assetTrack.isConvertNALSize {
+            // 3-byte lengths in the packets; `FFmpegAssetTrack` rewrote the extradata to declare 4 for VideoToolbox.
+            nalLengthSize = 3
+        } else if isHEVC, codecpar.extradata_size > 22, extradata[0] == 1 {
+            nalLengthSize = Int(extradata[21] & 3) + 1
+        } else if !isHEVC, codecpar.extradata_size > 6, extradata[0] == 1 {
+            nalLengthSize = Int(extradata[4] & 3) + 1
+        } else {
+            return nil // Annex B
+        }
+    }
+
+    struct Result {
+        var staticMetadata: EDRMetaData?
+        var hdr10Plus: Data?
+    }
+
+    func scan(_ data: UnsafePointer<UInt8>, size: Int) -> Result {
+        var result = Result()
+        var position = 0
+        while position + nalLengthSize < size {
+            var nalSize = 0
+            for i in 0 ..< nalLengthSize {
+                nalSize = nalSize << 8 | Int(data[position + i])
+            }
+            position += nalLengthSize
+            guard nalSize > 0, position + nalSize <= size else { break }
+            let headerSize = isHEVC ? 2 : 1
+            let type = isHEVC ? Int(data[position] >> 1) & 0x3F : Int(data[position]) & 0x1F
+            if type == (isHEVC ? 39 : 6), nalSize > headerSize {
+                parseSEI(rbsp(data + position + headerSize, count: nalSize - headerSize), into: &result)
+            }
+            position += nalSize
+        }
+        return result
+    }
+
+    /// Removes emulation prevention bytes (0x000003 → 0x0000).
+    private func rbsp(_ data: UnsafePointer<UInt8>, count: Int) -> [UInt8] {
+        var bytes = [UInt8]()
+        bytes.reserveCapacity(count)
+        var zeros = 0
+        for i in 0 ..< count {
+            let byte = data[i]
+            if zeros >= 2, byte == 3 {
+                zeros = 0
+                continue
+            }
+            zeros = byte == 0 ? zeros + 1 : 0
+            bytes.append(byte)
+        }
+        return bytes
+    }
+
+    private func parseSEI(_ bytes: [UInt8], into result: inout Result) {
+        var index = 0
+        func readValue() -> Int? {
+            var value = 0
+            while index < bytes.count {
+                let byte = bytes[index]
+                index += 1
+                value += Int(byte)
+                if byte != 0xFF { return value }
+            }
+            return nil
+        }
+        // Stop at the RBSP trailing bits (0x80).
+        while index < bytes.count, bytes[index] != 0x80 {
+            guard let type = readValue(), let size = readValue(), index + size <= bytes.count else { return }
+            let payload = Data(bytes[index ..< index + size])
+            index += size
+            switch type {
+            case 137:
+                if let display = MasteringDisplayMetadata(seiPayload: payload) {
+                    let metadata = EDRMetaData(displayData: display, contentData: nil, ambientViewingEnvironment: nil)
+                    result.staticMetadata = result.staticMetadata?.merging(metadata) ?? metadata
+                }
+            case 144:
+                if let content = ContentLightMetadata(seiPayload: payload) {
+                    let metadata = EDRMetaData(displayData: nil, contentData: content, ambientViewingEnvironment: nil)
+                    result.staticMetadata = result.staticMetadata?.merging(metadata) ?? metadata
+                }
+            case 4:
+                // user_data_registered_itu_t_t35: HDR10+ is country 0xB5, provider 0x003C, oriented code 0x0001,
+                // application identifier 4; the payload is already in the attachment's format.
+                if payload.starts(with: [0xB5, 0x00, 0x3C, 0x00, 0x01, 0x04]) {
+                    result.hdr10Plus = payload
+                }
+            default:
+                break
+            }
+        }
+    }
+}
