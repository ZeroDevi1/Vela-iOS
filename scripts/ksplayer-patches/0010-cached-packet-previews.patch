diff --git a/Sources/KSPlayer/MEPlayer/CachedVideoPreview.swift b/Sources/KSPlayer/MEPlayer/CachedVideoPreview.swift
new file mode 100644
index 0000000..4e973d9
--- /dev/null
+++ b/Sources/KSPlayer/MEPlayer/CachedVideoPreview.swift
@@ -0,0 +1,194 @@
+import AVFoundation
+import Foundation
+import Libavcodec
+import Libavformat
+
+public struct KSCachedVideoPreview: Sendable {
+    public let image: CGImage
+    public let time: TimeInterval
+}
+
+/// 前向数据留在播放队列。仅保留一小段已送解码的包，从而补齐队首所在 GOP 的关键帧。
+final class CachedVideoPreview: @unchecked Sendable {
+    private final class Stream {
+        let parameters: UnsafeMutablePointer<AVCodecParameters>
+        let trackID: Int32
+        let secondsPerTick: Double
+        let startTime: TimeInterval
+
+        init?(track: FFmpegAssetTrack, startTime: TimeInterval) {
+            guard track.timebase.den > 0, abs(track.rotation) < 1,
+                  let parameters = avcodec_parameters_alloc() else { return nil }
+            let result = withUnsafePointer(to: track.codecpar) { avcodec_parameters_copy(parameters, $0) }
+            guard result >= 0 else {
+                var copy: UnsafeMutablePointer<AVCodecParameters>? = parameters
+                avcodec_parameters_free(&copy)
+                return nil
+            }
+            self.parameters = parameters
+            trackID = track.trackID
+            secondsPerTick = Double(track.timebase.num) / Double(track.timebase.den)
+            self.startTime = startTime
+        }
+
+        deinit {
+            var copy: UnsafeMutablePointer<AVCodecParameters>? = parameters
+            avcodec_parameters_free(&copy)
+        }
+
+        func time(_ timestamp: Int64) -> TimeInterval {
+            Double(timestamp) * secondsPerTick - startTime
+        }
+    }
+
+    private let lock = NSLock()
+    private var stream: Stream?
+    private var lastTrackID: Int32?
+    private weak var queue: CircularBuffer<Packet>?
+    private var history: [Packet] = []
+    private var historyBytes = 0
+    private var revision = 0
+    private let historyLimit = 24 * 1024 * 1024
+    private let packetLimit = 720
+
+    func attach(to queue: CircularBuffer<Packet>?) {
+        lock.withLock { self.queue = queue }
+    }
+
+    /// 由读包线程调用。深拷贝编解码参数，使预览快照不依赖主解封装器的生命周期。
+    func prepare(track: FFmpegAssetTrack, startTime: TimeInterval) {
+        lock.withLock {
+            guard lastTrackID != track.trackID else { return }
+            lastTrackID = track.trackID
+            stream = Stream(track: track, startTime: startTime)
+            resetHistory()
+        }
+    }
+
+    func record(_ packet: Packet) {
+        lock.withLock {
+            guard stream?.trackID == packet.assetTrack.trackID, packet.size > 0,
+                  !history.isEmpty || packet.isKeyFrame else { return }
+            history.append(packet)
+            historyBytes += Int(packet.size)
+            if historyBytes > historyLimit || history.count > packetLimit {
+                let count = history.dropFirst().firstIndex(where: { $0.isKeyFrame }) ?? history.count
+                historyBytes -= history.prefix(count).reduce(0) { $0 + Int($1.size) }
+                history.removeFirst(count)
+            }
+        }
+    }
+
+    func flush() {
+        lock.withLock { resetHistory() }
+    }
+
+    func close() {
+        lock.withLock {
+            resetHistory()
+            stream = nil
+            lastTrackID = nil
+            queue = nil
+        }
+    }
+
+    private func resetHistory() {
+        history.removeAll()
+        historyBytes = 0
+        revision &+= 1
+    }
+
+    func frame(at target: TimeInterval, width: Int32) -> KSCachedVideoPreview? {
+        let (currentStream, queue, revision) = lock.withLock { (stream, self.queue, self.revision) }
+        guard let currentStream, !Task.isCancelled else { return nil }
+        // 先读待解码队列，再读历史。两次读取之间移动的包可能出现两次，按对象身份合并。
+        let pending = queue?.snapshot() ?? []
+        guard let history = lock.withLock({ self.revision == revision ? self.history : nil }) else { return nil }
+        let end = pending.first.flatMap { first in history.firstIndex(where: { $0 === first }) } ?? history.count
+        let packets = Array(history.prefix(end)) + pending
+        var start: Int?
+        var reached: Int?
+        var next = packets.count
+        for (index, packet) in packets.enumerated() {
+            guard !Task.isCancelled else { return nil }
+            guard packet.assetTrack.trackID == currentStream.trackID else {
+                if reached != nil { next = index; break }
+                start = nil
+                continue
+            }
+            guard packet.timestamp != .min else { continue }
+            let time = currentStream.time(packet.timestamp)
+            if packet.isKeyFrame {
+                if time <= target {
+                    start = index
+                    reached = nil
+                } else {
+                    if start == nil { return nil }
+                    if reached != nil {
+                        next = index
+                        break
+                    }
+                }
+            }
+            if start != nil, time >= target, reached == nil { reached = index }
+            // 给有 B 帧重排的解码器少量读前数据。
+            if let reached, index - reached >= 16 { next = index + 1; break }
+        }
+        guard let start, reached != nil, next - start <= packetLimit, start < next else { return nil }
+        return decode(packets[start..<next], stream: currentStream, target: target, width: width)
+    }
+
+    private func decode(_ packets: ArraySlice<Packet>, stream: Stream, target: TimeInterval, width: Int32) -> KSCachedVideoPreview? {
+        let options = KSOptions()
+        options.hardwareDecode = false
+        options.decoderOptions["threads"] = "2"
+        var parameters = stream.parameters.pointee
+        guard let decoder = try? parameters.createContext(options: options) else { return nil }
+        defer {
+            var pointer: UnsafeMutablePointer<AVCodecContext>? = decoder
+            avcodec_free_context(&pointer)
+        }
+        var output = av_frame_alloc()
+        var best = av_frame_alloc()
+        defer {
+            av_frame_free(&output)
+            av_frame_free(&best)
+        }
+        guard let output, let best else { return nil }
+        var bestTime = TimeInterval.infinity
+        func receive() -> Bool {
+            while !Task.isCancelled, avcodec_receive_frame(decoder, output) >= 0 {
+                defer { av_frame_unref(output) }
+                let timestamp = output.pointee.best_effort_timestamp
+                guard timestamp != .min else { continue }
+                let time = stream.time(timestamp)
+                if abs(time - target) < abs(bestTime - target) {
+                    av_frame_unref(best)
+                    if av_frame_ref(best, output) >= 0 { bestTime = time }
+                }
+                if time >= target { return true }
+            }
+            return false
+        }
+
+        var reached = false
+        for packet in packets {
+            guard !Task.isCancelled, let input = packet.corePacket,
+                  avcodec_send_packet(decoder, input) >= 0 else { return nil }
+            if receive() { reached = true; break }
+        }
+        if !reached, !Task.isCancelled {
+            _ = avcodec_send_packet(decoder, nil)
+            _ = receive()
+        }
+
+        let frame = best.pointee
+        guard !Task.isCancelled, abs(bestTime - target) <= 0.75, frame.width > 0, frame.height > 0 else { return nil }
+        let width = min(width, frame.width)
+        let height = max(1, Int32(Int64(frame.height) * Int64(width) / Int64(frame.width)))
+        let scaler = VideoSwresample(dstWidth: width, dstHeight: height, isDovi: false)
+        defer { scaler.shutdown() }
+        guard let image = scaler.transfer(frame: frame, forceScale: true)?.cgImage() else { return nil }
+        return KSCachedVideoPreview(image: image, time: bestTime)
+    }
+}
