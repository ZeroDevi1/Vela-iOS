diff --git a/Sources/KSPlayer/MEPlayer/PassthroughAudioDecode.swift b/Sources/KSPlayer/MEPlayer/PassthroughAudioDecode.swift
new file mode 100644
index 0000000..e530c86
--- /dev/null
+++ b/Sources/KSPlayer/MEPlayer/PassthroughAudioDecode.swift
@@ -0,0 +1,300 @@
+//
+//  PassthroughAudioDecode.swift
+//  KSPlayer
+//
+//  Vela: compressed audio passthrough (Dolby Digital / Dolby Digital Plus incl. Atmos JOC).
+//
+
+import AVFoundation
+import Libavcodec
+
+public extension FFmpegAssetTrack {
+    /// Vela: Core Audio format ID used when this track is passed through without decoding; nil if unsupported.
+    /// Only AC-3 / E-AC-3: the system decodes them itself (E-AC-3 JOC as Dolby Atmos, spatialized or sent over HDMI).
+    var passthroughAudioFormatID: AudioFormatID? {
+        switch codecpar.codec_id {
+        case AV_CODEC_ID_EAC3: kAudioFormatEnhancedAC3
+        case AV_CODEC_ID_AC3: kAudioFormatAC3
+        default: nil
+        }
+    }
+
+    /// Vela: E-AC-3 with Joint Object Coding, i.e. Dolby Atmos (profile detected by FFmpeg's parser while probing).
+    var isDolbyAtmos: Bool {
+        codecpar.codec_id == AV_CODEC_ID_EAC3 && codecpar.profile == AV_PROFILE_EAC3_DDP_ATMOS
+    }
+}
+
+/// Vela: wraps each AC-3 / E-AC-3 packet into a compressed `CMSampleBuffer` instead of decoding it to PCM.
+/// The frames are rendered by `AVSampleBufferAudioRenderer` (`AudioRendererPlayer`), so the system decodes them:
+/// Dolby Atmos objects are kept (spatial audio / Atmos-capable outputs) and more than 2 channels reach the output.
+/// Only valid with `AudioRendererPlayer`; other audio outputs cannot render compressed frames.
+final class PassthroughAudioDecode: DecodeProtocol {
+    private let formatID: AudioFormatID
+    private let sampleRate: Int32
+    private let channelCount: UInt32
+    private let bitRate: Int64
+    private let isDolbyAtmos: Bool
+    /// PCM format of the track, only used for `AudioFrame.audioFormat` (channel count / sample rate bookkeeping).
+    private let audioFormat: AVAudioFormat
+    /// Built from the first packet: the E-AC-3 cookie (`dec3`) describes the substreams found in the bitstream.
+    private var formatDescription: CMAudioFormatDescription?
+    /// Presentation time the next packet should have if the stream is continuous (sample-accurate).
+    private var expectedTime: CMTime?
+
+    init?(assetTrack: FFmpegAssetTrack) {
+        guard let formatID = assetTrack.passthroughAudioFormatID, let audioDescriptor = assetTrack.audioDescriptor else {
+            return nil
+        }
+        self.formatID = formatID
+        sampleRate = assetTrack.codecpar.sample_rate > 0 ? assetTrack.codecpar.sample_rate : 48000
+        channelCount = UInt32(max(assetTrack.codecpar.ch_layout.nb_channels, 2))
+        bitRate = assetTrack.codecpar.bit_rate
+        isDolbyAtmos = assetTrack.isDolbyAtmos
+        audioFormat = audioDescriptor.audioFormat
+    }
+
+    func decode() {}
+
+    func decodeFrame(from packet: Packet, completionHandler: @escaping (Result<MEFrame, Error>) -> Void) {
+        guard let corePacket = packet.corePacket?.pointee, let bytes = corePacket.data, corePacket.size > 0 else {
+            return
+        }
+        let size = Int(corePacket.size)
+        let buffer = UnsafeBufferPointer(start: bytes, count: size)
+        let frames = DolbyAudioSyncFrames(buffer)
+        let samples = frames.samplesPerFrame ?? 1536
+        if formatDescription == nil {
+            formatDescription = makeFormatDescription(framesPerPacket: samples, cookie: frames.dec3(dataRate: bitRate, isDolbyAtmos: isDolbyAtmos))
+            KSLog("[audio] passthrough \(formatID == kAudioFormatEnhancedAC3 ? "E-AC-3" : "AC-3") \(channelCount)ch atmos=\(isDolbyAtmos) cookie=\(formatDescription.flatMap { CMAudioFormatDescriptionGetMagicCookie($0, sizeOut: nil) } != nil)")
+        }
+        // Container timestamps are rounded (Matroska: 1 ms), so 44.1 kHz frames (34.83 ms) jitter by a fraction of a
+        // millisecond. The renderer treats every such gap as a discontinuity and resets the decoder for each packet,
+        // so keep the timeline sample-accurate and only follow the container on a real jump (> 1/4 frame).
+        let frameDuration = CMTime(value: CMTimeValue(samples), timescale: sampleRate)
+        var time = packet.cmtime
+        if let expectedTime, (time - expectedTime).seconds.magnitude < frameDuration.seconds / 4 {
+            time = expectedTime
+        }
+        expectedTime = time + frameDuration
+        guard let formatDescription, let sampleBuffer = makeSampleBuffer(bytes: bytes, size: size, time: time, formatDescription: formatDescription) else {
+            completionHandler(.failure(NSError(domain: "KSPlayer.Passthrough", code: -1, userInfo: [NSLocalizedDescriptionKey: "cannot wrap compressed audio packet"])))
+            return
+        }
+        let frame = AudioFrame(dataSize: 0, audioFormat: audioFormat)
+        frame.compressedSampleBuffer = sampleBuffer
+        frame.timebase = packet.assetTrack.timebase
+        frame.timestamp = packet.timestamp
+        frame.duration = packet.duration > 0 ? packet.duration : packet.assetTrack.timebase.getPosition(from: Double(samples) / Double(sampleRate))
+        frame.position = packet.position
+        frame.size = packet.size
+        frame.numberOfSamples = UInt32(samples)
+        completionHandler(.success(frame))
+    }
+
+    func doFlushCodec() {
+        expectedTime = nil
+    }
+
+    func shutdown() {}
+
+    private func makeFormatDescription(framesPerPacket: Int, cookie: [UInt8]?) -> CMAudioFormatDescription? {
+        var asbd = AudioStreamBasicDescription(
+            mSampleRate: Float64(sampleRate), mFormatID: formatID, mFormatFlags: 0, mBytesPerPacket: 0,
+            mFramesPerPacket: UInt32(framesPerPacket), mBytesPerFrame: 0, mChannelsPerFrame: channelCount,
+            mBitsPerChannel: 0, mReserved: 0
+        )
+        var description: CMAudioFormatDescription?
+        let status: OSStatus
+        if let cookie {
+            status = cookie.withUnsafeBytes {
+                CMAudioFormatDescriptionCreate(allocator: kCFAllocatorDefault, asbd: &asbd, layoutSize: 0, layout: nil, magicCookieSize: cookie.count, magicCookie: $0.baseAddress, extensions: nil, formatDescriptionOut: &description)
+            }
+        } else {
+            status = CMAudioFormatDescriptionCreate(allocator: kCFAllocatorDefault, asbd: &asbd, layoutSize: 0, layout: nil, magicCookieSize: 0, magicCookie: nil, extensions: nil, formatDescriptionOut: &description)
+        }
+        if status != noErr {
+            KSLog("[audio] passthrough format description failed: \(status)")
+        }
+        return description
+    }
+
+    private func makeSampleBuffer(bytes: UnsafePointer<UInt8>, size: Int, time: CMTime, formatDescription: CMAudioFormatDescription) -> CMSampleBuffer? {
+        var blockBuffer: CMBlockBuffer?
+        guard CMBlockBufferCreateWithMemoryBlock(allocator: kCFAllocatorDefault, memoryBlock: nil, blockLength: size, blockAllocator: kCFAllocatorDefault, customBlockSource: nil, offsetToData: 0, dataLength: size, flags: kCMBlockBufferAssureMemoryNowFlag, blockBufferOut: &blockBuffer) == noErr,
+              let blockBuffer,
+              CMBlockBufferReplaceDataBytes(with: bytes, blockBuffer: blockBuffer, offsetIntoDestination: 0, dataLength: size) == noErr
+        else {
+            return nil
+        }
+        // One access unit (independent substream plus its dependent substreams) is one packet of the compressed format.
+        var packetDescription = AudioStreamPacketDescription(mStartOffset: 0, mVariableFramesInPacket: 0, mDataByteSize: UInt32(size))
+        var sampleBuffer: CMSampleBuffer?
+        CMAudioSampleBufferCreateReadyWithPacketDescriptions(allocator: kCFAllocatorDefault, dataBuffer: blockBuffer, formatDescription: formatDescription, sampleCount: 1, presentationTimeStamp: time, packetDescriptions: &packetDescription, sampleBufferOut: &sampleBuffer)
+        return sampleBuffer
+    }
+}
+
+/// Vela: the AC-3 / E-AC-3 syncframes of one packet (ETSI TS 102 366), parsed only as far as needed to build the
+/// `dec3` cookie (Annex F.6) and the number of PCM samples per frame.
+struct DolbyAudioSyncFrames {
+    struct Substream: Equatable {
+        var fscod: UInt32
+        var bsid: UInt32
+        var bsmod: UInt32 = 0
+        var acmod: UInt32
+        var lfeon: UInt32
+        var numDependentSubstreams: UInt32 = 0
+        var channelLocations: UInt32 = 0
+    }
+
+    /// Independent substreams with their dependent substreams folded in, in bitstream order.
+    private(set) var independent: [Substream] = []
+    private(set) var samplesPerFrame: Int?
+    private(set) var isEnhanced = false
+
+    init(_ data: UnsafeBufferPointer<UInt8>) {
+        var offset = 0
+        while offset + 6 <= data.count, data[offset] == 0x0B, data[offset + 1] == 0x77 {
+            var reader = BitReader(data, byteOffset: offset + 2)
+            let bsid = UInt32((data[offset + 5] >> 3) & 0x1F)
+            if bsid <= 10 {
+                // AC-3: syncinfo crc1(16) fscod(2) frmsizecod(6), then bsid(5) bsmod(3) acmod(3).
+                reader.skip(16)
+                let fscod = reader.read(2)
+                let frmsizecod = reader.read(6)
+                reader.skip(5)
+                let bsmod = reader.read(3)
+                let acmod = reader.read(3)
+                if acmod & 1 != 0, acmod != 1 { reader.skip(2) } // cmixlev
+                if acmod & 4 != 0 { reader.skip(2) } // surmixlev
+                if acmod == 2 { reader.skip(2) } // dsurmod
+                let lfeon = reader.read(1)
+                independent.append(Substream(fscod: fscod, bsid: bsid, bsmod: bsmod, acmod: acmod, lfeon: lfeon))
+                samplesPerFrame = samplesPerFrame ?? 1536
+                guard let length = Self.ac3FrameLength(fscod: fscod, frmsizecod: frmsizecod) else { break }
+                offset += length
+            } else if bsid <= 16 {
+                isEnhanced = true
+                let strmtyp = reader.read(2)
+                reader.skip(3) // substreamid
+                let frmsiz = reader.read(11)
+                var fscod = reader.read(2)
+                let numblkscod: UInt32
+                if fscod == 3 {
+                    fscod = reader.read(2) // fscod2: reduced sample rates
+                    numblkscod = 3
+                } else {
+                    numblkscod = reader.read(2)
+                }
+                let acmod = reader.read(3)
+                let lfeon = reader.read(1)
+                reader.skip(5) // bsid
+                reader.skip(5) // dialnorm
+                if reader.read(1) == 1 { reader.skip(8) } // compre, compr
+                if acmod == 0 {
+                    reader.skip(5)
+                    if reader.read(1) == 1 { reader.skip(8) }
+                }
+                var chanmap: UInt32 = 0
+                if strmtyp == 1, reader.read(1) == 1 { chanmap = reader.read(16) }
+                if strmtyp == 1, !independent.isEmpty {
+                    // Dependent substream: extra channels of the preceding independent one (dec3 chan_loc, as FFmpeg's movenc).
+                    independent[independent.count - 1].numDependentSubstreams += 1
+                    independent[independent.count - 1].channelLocations |= (chanmap >> 5) & 0x1FF
+                } else {
+                    independent.append(Substream(fscod: fscod, bsid: 16, acmod: acmod, lfeon: lfeon))
+                    samplesPerFrame = samplesPerFrame ?? [1, 2, 3, 6][Int(numblkscod)] * 256
+                }
+                offset += (Int(frmsiz) + 1) * 2
+            } else {
+                break
+            }
+        }
+    }
+
+    /// `dec3` payload (EC3SpecificBox without the box header). nil for AC-3 or when no frame could be parsed.
+    /// For Dolby Atmos, `flag_ec3_extension_type_a` is set: the complexity index is not in the parsed fields, so the
+    /// common value 16 is assumed (informational; the decoder reads the JOC data from the bitstream itself).
+    func dec3(dataRate bitRate: Int64, isDolbyAtmos: Bool) -> [UInt8]? {
+        guard isEnhanced, !independent.isEmpty, independent.count <= 8 else { return nil }
+        var writer = BitWriter()
+        writer.write(UInt32(min(max(bitRate / 1000, 0), 0x1FFF)), bits: 13)
+        writer.write(UInt32(independent.count - 1), bits: 3)
+        for substream in independent {
+            writer.write(substream.fscod, bits: 2)
+            writer.write(substream.bsid, bits: 5)
+            writer.write(0, bits: 1) // reserved
+            writer.write(0, bits: 1) // asvc
+            writer.write(substream.bsmod, bits: 3)
+            writer.write(substream.acmod, bits: 3)
+            writer.write(substream.lfeon, bits: 1)
+            writer.write(0, bits: 3) // reserved
+            writer.write(substream.numDependentSubstreams, bits: 4)
+            if substream.numDependentSubstreams > 0 {
+                writer.write(substream.channelLocations, bits: 9)
+            } else {
+                writer.write(0, bits: 1) // reserved
+            }
+        }
+        if isDolbyAtmos {
+            writer.write(0, bits: 7) // reserved
+            writer.write(1, bits: 1) // flag_ec3_extension_type_a
+            writer.write(16, bits: 8) // complexity_index_type_a
+        }
+        return writer.bytes
+    }
+
+    /// AC-3 frame length in bytes (ETSI TS 102 366 Table 4.13); nil for reserved codes.
+    private static func ac3FrameLength(fscod: UInt32, frmsizecod: UInt32) -> Int? {
+        let bitRates = [32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320, 384, 448, 512, 576, 640]
+        guard fscod < 3, frmsizecod < 38 else { return nil }
+        let kbps = bitRates[Int(frmsizecod / 2)]
+        switch fscod {
+        case 0: return kbps * 4 // 48 kHz: words = 2 * kbps
+        case 1: return (kbps * 320 / 147 + Int(frmsizecod & 1)) * 2 // 44.1 kHz
+        default: return kbps * 6 // 32 kHz
+        }
+    }
+}
+
+private struct BitReader {
+    private let data: UnsafeBufferPointer<UInt8>
+    private var bitOffset: Int
+
+    init(_ data: UnsafeBufferPointer<UInt8>, byteOffset: Int) {
+        self.data = data
+        bitOffset = byteOffset * 8
+    }
+
+    mutating func skip(_ bits: Int) {
+        bitOffset += bits
+    }
+
+    /// Reads up to 32 bits MSB first; bits past the end read as 0.
+    mutating func read(_ bits: Int) -> UInt32 {
+        var value: UInt32 = 0
+        for _ in 0 ..< bits {
+            let byte = bitOffset / 8
+            let bit = byte < data.count ? (data[byte] >> (7 - UInt8(bitOffset % 8))) & 1 : 0
+            value = value << 1 | UInt32(bit)
+            bitOffset += 1
+        }
+        return value
+    }
+}
+
+private struct BitWriter {
+    private(set) var bytes: [UInt8] = []
+    private var bitCount = 0
+
+    mutating func write(_ value: UInt32, bits: Int) {
+        for index in stride(from: bits - 1, through: 0, by: -1) {
+            if bitCount % 8 == 0 { bytes.append(0) }
+            if (value >> UInt32(index)) & 1 == 1 {
+                bytes[bytes.count - 1] |= 0x80 >> UInt8(bitCount % 8)
+            }
+            bitCount += 1
+        }
+    }
+}
