+//
+//  PassthroughVideoDecode.swift
+//  KSPlayer
+//
+//  Vela: compressed video passthrough (Dolby Vision profile 5 / 8 rendered by the system).
+//
+
+import AVFoundation
+import Libavcodec
+import Libavformat
+
+public extension FFmpegAssetTrack {
+    /// Vela: Dolby Vision profile from the container's configuration record (`dvcC` / `dvvC`), nil if none.
+    var doviProfile: UInt8? {
+        dovi?.dv_profile
+    }
+
+    /// Vela: format description for passing this HEVC track to `AVSampleBufferDisplayLayer` undecoded; nil if
+    /// unsupported. With a Dolby Vision configuration the codec is `dvh1` and the record is attached next to `hvcC`,
+    /// so the system decoder applies the RPU (profile 5 IPTPQc2 / profile 8 reshaping) instead of showing the base layer.
+    var passthroughVideoFormatDescription: CMVideoFormatDescription? {
+        guard codecpar.codec_id == AV_CODEC_ID_HEVC, let formatDescription,
+              var extensions = CMFormatDescriptionGetExtensions(formatDescription) as? [CFString: Any],
+              var atoms = extensions[kCMFormatDescriptionExtension_SampleDescriptionExtensionAtoms] as? [String: Any],
+              atoms["hvcC"] != nil
+        else {
+            return nil
+        }
+        var codecType = kCMVideoCodecType_HEVC
+        if let dovi {
+            codecType = kCMVideoCodecType_DolbyVisionHEVC
+            atoms[dovi.dv_profile > 7 ? "dvvC" : "dvcC"] = dovi.configurationBox
+            extensions[kCMFormatDescriptionExtension_SampleDescriptionExtensionAtoms] = atoms
+        }
+        // Decoder hints for VideoToolbox sessions; the display layer picks its own decoder.
+        extensions.removeValue(forKey: "EnableHardwareAcceleratedVideoDecoder" as CFString)
+        extensions.removeValue(forKey: kCVPixelBufferPixelFormatTypeKey)
+        var description: CMVideoFormatDescription?
+        let status = CMVideoFormatDescriptionCreate(allocator: kCFAllocatorDefault, codecType: codecType, width: codecpar.width, height: codecpar.height, extensions: extensions as CFDictionary, formatDescriptionOut: &description)
+        if status != noErr {
+            KSLog("[video] passthrough format description failed: \(status)")
+        }
+        return description
+    }
+}
+
+extension DOVIDecoderConfigurationRecord {
+    /// Payload of the `dvcC` / `dvvC` box (Dolby Vision streams within the ISO base media file format, 24 bytes).
+    var configurationBox: Data {
+        var bytes = [UInt8](repeating: 0, count: 24)
+        bytes[0] = dv_version_major
+        bytes[1] = dv_version_minor
+        bytes[2] = (dv_profile & 0x7F) << 1 | (dv_level >> 5) & 0x01
+        bytes[3] = (dv_level & 0x1F) << 3 | (rpu_present_flag & 1) << 2 | (el_present_flag & 1) << 1 | (bl_present_flag & 1)
+        bytes[4] = (dv_bl_signal_compatibility_id & 0x0F) << 4
+        return Data(bytes)
+    }
+}
+
+/// Vela: wraps each HEVC packet into a compressed `CMSampleBuffer` (demux order, presentation timestamps only).
+/// `MetalPlayView` enqueues them ahead of time into its `AVSampleBufferDisplayLayer`, whose timebase is
+/// the audio synchronizer's, so the system decodes and presents them (Dolby Vision mapping included).
+/// Costs: no decoded `CVPixelBuffer` (thumbnails, VR, burning subtitles into Picture in Picture frames).
+final class PassthroughVideoDecode: DecodeProtocol {
+    private let formatDescription: CMVideoFormatDescription
+    private let isConvertNALSize: Bool
+    private let fps: Float
+    private let isDovi: Bool
+    /// Queue position of the previous frame (see `decodeFrame`).
+    private var lastQueueTimestamp = Int64.min
+
+    init?(assetTrack: FFmpegAssetTrack) {
+        guard let formatDescription = assetTrack.passthroughVideoFormatDescription else {
+            return nil
+        }
+        self.formatDescription = formatDescription
+        isConvertNALSize = assetTrack.isConvertNALSize
+        fps = assetTrack.nominalFrameRate
+        isDovi = assetTrack.dovi != nil
+        KSLog("[video] passthrough \(formatDescription.mediaSubType) dovi=\(assetTrack.doviProfile.map(String.init) ?? "-")")
+    }
+
+    func decode() {}
+
+    func decodeFrame(from packet: Packet, completionHandler: @escaping (Result<MEFrame, Error>) -> Void) {
+        guard let corePacket = packet.corePacket?.pointee, let data = corePacket.data, corePacket.size > 0 else {
+            return
+        }
+        let timebase = packet.assetTrack.timebase
+        let pts = packet.timestamp
+        let duration = corePacket.duration
+        // No decode timestamp: Matroska stores none and the one libavformat guesses is not monotonic, so the layer
+        // decodes in enqueue order (= demux order, see below).
+        var timing = CMSampleTimingInfo(
+            duration: duration > 0 ? timebase.cmtime(for: duration) : .invalid,
+            presentationTimeStamp: timebase.cmtime(for: pts),
+            decodeTimeStamp: .invalid
+        )
+        guard let sampleBuffer = makeSampleBuffer(data: data, size: Int(corePacket.size), timing: &timing, isKeyFrame: packet.isKeyFrame) else {
+            completionHandler(.failure(NSError(domain: "KSPlayer.Passthrough", code: -1, userInfo: [NSLocalizedDescriptionKey: "cannot wrap compressed video packet"])))
+            return
+        }
+        let frame = VideoVTBFrame(fps: fps, isDovi: isDovi)
+        frame.compressedSampleBuffer = sampleBuffer
+        frame.timebase = timebase
+        // The frame queue is sorted by timestamp but the layer needs demux order: leading pictures after a key frame
+        // have earlier presentation times. Use a strictly increasing position that stays within 0.5 s of the
+        // presentation time, so buffering estimates based on frame times remain meaningful.
+        let queueTimestamp = max(lastQueueTimestamp == Int64.min ? Int64.min : lastQueueTimestamp + 1, pts - timebase.getPosition(from: 0.5))
+        lastQueueTimestamp = queueTimestamp
+        frame.timestamp = queueTimestamp
+        frame.duration = duration
+        frame.position = packet.position
+        frame.size = packet.size
+        completionHandler(.success(frame))
+    }
+
+    func doFlushCodec() {
+        lastQueueTimestamp = Int64.min
+    }
+
+    func shutdown() {}
+
+    private func makeSampleBuffer(data: UnsafeMutablePointer<UInt8>, size: Int, timing: inout CMSampleTimingInfo, isKeyFrame: Bool) -> CMSampleBuffer? {
+        // Copy: the packet is released after this call while the sample buffer waits in the queue.
+        var bytes = [UInt8](UnsafeBufferPointer(start: data, count: size))
+        if isConvertNALSize {
+            // 3-byte NAL length prefixes (hvcC lengthSizeMinusOne patched to 4 bytes in FFmpegAssetTrack).
+            var converted = [UInt8]()
+            converted.reserveCapacity(size + size / 64)
+            var offset = 0
+            while offset + 3 <= size {
+                let length = Int(bytes[offset]) << 16 | Int(bytes[offset + 1]) << 8 | Int(bytes[offset + 2])
+                offset += 3
+                guard offset + length <= size else { break }
+                converted.append(contentsOf: [UInt8(length >> 24 & 0xFF), UInt8(length >> 16 & 0xFF), UInt8(length >> 8 & 0xFF), UInt8(length & 0xFF)])
+                converted.append(contentsOf: bytes[offset ..< offset + length])
+                offset += length
+            }
+            bytes = converted
+        }
+        var blockBuffer: CMBlockBuffer?
+        guard CMBlockBufferCreateWithMemoryBlock(allocator: kCFAllocatorDefault, memoryBlock: nil, blockLength: bytes.count, blockAllocator: kCFAllocatorDefault, customBlockSource: nil, offsetToData: 0, dataLength: bytes.count, flags: kCMBlockBufferAssureMemoryNowFlag, blockBufferOut: &blockBuffer) == noErr,
+              let blockBuffer,
+              CMBlockBufferReplaceDataBytes(with: bytes, blockBuffer: blockBuffer, offsetIntoDestination: 0, dataLength: bytes.count) == noErr
+        else {
+            return nil
+        }
+        var sampleBuffer: CMSampleBuffer?
+        var sampleSize = bytes.count
+        CMSampleBufferCreateReady(allocator: kCFAllocatorDefault, dataBuffer: blockBuffer, formatDescription: formatDescription, sampleCount: 1, sampleTimingEntryCount: 1, sampleTimingArray: &timing, sampleSizeEntryCount: 1, sampleSizeArray: &sampleSize, sampleBufferOut: &sampleBuffer)
+        // Sync flags let the layer resume decoding at a key frame after a flush.
+        if let sampleBuffer, !isKeyFrame,
+           let attachments = CMSampleBufferGetSampleAttachmentsArray(sampleBuffer, createIfNecessary: true) as? [NSMutableDictionary],
+           let attachment = attachments.first
+        {
+            attachment[kCMSampleAttachmentKey_NotSync] = true
+        }
+        return sampleBuffer
+    }
+}
