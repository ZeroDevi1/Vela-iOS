+/// Vela: some muxers write ctts as a constant offset, so pts equal dts plus a constant (decode order) although the
+/// stream has B-frames. Within a GOP of a correctly muxed reordered stream pts go backwards at the first B-frame;
+/// if a whole GOP (at least `minPackets`) stays monotonic while the codec declares reordering, the container pts
+/// cannot be trusted for display order.
+///
+/// A stream that declares reordering but encodes no B-frames is also flagged; the fallback stays hardware decoded,
+/// so the misjudgement only costs the asynchronous VideoToolbox path.
+struct DecodeOrderPTSProbe {
+    static let minPackets = 8
+    /// nil until decided; true once the track should leave the VideoToolbox path.
+    private(set) var verdict: Bool?
+    /// A GOP is being observed (started at a keyframe after the last reset).
+    private var observing = false
+    private var lastPTS = Int64.min
+    private var packets = 0
+
+    /// Restarts observation after a flush or seek, unless already decided.
+    mutating func reset() {
+        guard verdict == nil else { return }
+        observing = false
+        lastPTS = .min
+        packets = 0
     }
+
+    /// Feeds one packet in decode order.
+    /// - Parameters:
+    ///   - pts: Container pts; `Int64.min` (AV_NOPTS_VALUE) when missing.
+    ///   - reorderDelay: `codecpar.video_delay`, the declared number of reordered frames.
+    /// - Returns: true exactly once, on the keyframe that closes a monotonic GOP; decode that keyframe with
+    ///   another decoder.
+    mutating func observe(pts: Int64, isKeyFrame: Bool, reorderDelay: Int32) -> Bool {
+        guard verdict == nil else { return false }
+        guard reorderDelay > 0, pts != Int64.min else {
+            verdict = false
+            return false
+        }
+        if isKeyFrame {
+            if observing, packets >= Self.minPackets {
+                verdict = true
+                return true
+            }
+            observing = true
+            lastPTS = pts
+            packets = 1
+            return false
+        }
+        guard observing else { return false }
+        if pts < lastPTS {
+            verdict = false
+            return false
+        }
+        lastPTS = pts
+        packets += 1
+        return false
+    }
 }
 
