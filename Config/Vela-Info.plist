<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 与 GENERATE_INFOPLIST_FILE 生成的键合并；这里只放 build setting 无法表达的数组 / 字典键。 -->
	<key>UIBackgroundModes</key>
	<array>
		<!-- 后台音频与画中画持续播放。 -->
		<string>audio</string>
	</array>
	<!-- TMDB 内置凭据：由构建设置 VELA_TMDB_API_KEY 注入（例如本地 xcconfig），仓库中不保存 key。
	     未定义时为空，用户需在「设置 → 发现 → TMDB」中自行填写。 -->
	<key>VelaTMDBAPIKey</key>
	<string>$(VELA_TMDB_API_KEY)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- 自建媒体服务器常见为 HTTP（局域网或公网 DDNS），地址由用户输入，无法预先列入例外域名。
		     注意：不要再加 NSAllowsLocalNetworking / NSAllowsArbitraryLoadsForMedia /
		     NSAllowsArbitraryLoadsInWebContent，任一出现都会使 NSAllowsArbitraryLoads 被系统忽略。 -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
